{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patch.schema.json",
  "title": "FlowFixer-EDA constrained patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosis", "category", "restart_stage", "operations"],
  "properties": {
    "diagnosis": {"type": "string", "minLength": 1},
    "category": {
      "type": "string",
      "enum": [
        "RTL error",
        "Port mismatch",
        "SDC error",
        "Config error",
        "Floorplan error",
        "Placement error",
        "Routing error",
        "Timing error"
      ]
    },
    "restart_stage": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "op", "old", "new"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "op": {"const": "replace"},
          "old": {"type": "string", "minLength": 1},
          "new": {"type": "string"}
        }
      }
    }
  }
}
